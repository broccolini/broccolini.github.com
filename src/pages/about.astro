---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - broccolini.net">
  <main>
    <div style="margin-left: 10%;">
      <div class="container" style="margin-top: 20%; margin-bottom: var(--space-2);">
        <div style="width: 66.666%; padding-left: var(--space-2); padding-right: var(--space-3);">
          <div style="font-size: var(--font-size-6); font-weight: 700;">
            <a href="http://broccolini.net" style="color: var(--color-black); text-decoration: none;">
              broccolini
            </a>
          </div>
          <h1 style="font-size: var(--font-size-8); font-weight: 700; line-height: 1.25; margin: 0;">
            About
          </h1>
        </div>
      </div>
      
      <div class="container" style="margin-bottom: var(--space-5);">
        <div style="width: 50%;">
          <div style="font-family: var(--font-mono); font-size: var(--font-size-2); padding-left: var(--space-2); padding-right: var(--space-3);">
            <p>This is the about page for Diana Mounter's personal website.</p>
            <p>More content can be added here as needed.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>