---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const musingsPosts = await getCollection('musings');
const sortedPosts = musingsPosts.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<Layout title="Musings - broccolini.net">
  <main>
    <div style="margin-left: 10%;">
      <div class="container" style="margin-top: 20%; margin-bottom: var(--space-2);">
        <div style="width: 66.666%; padding-left: var(--space-2); padding-right: var(--space-3);">
          <div style="font-size: var(--font-size-6); font-weight: 700;">
            <a href="/" style="color: var(--color-black); text-decoration: none;">
              broccolini
            </a>
          </div>
          <h1 style="font-size: var(--font-size-8); font-weight: 700; line-height: 1.25; margin: 0;">
            Musings
          </h1>
        </div>
      </div>
      
      <div class="container" style="margin-bottom: var(--space-5);">
        <div style="width: 75%;">
          <div style="padding-left: var(--space-2); padding-right: var(--space-3);">
            {sortedPosts.map((post) => (
              <div style="margin-bottom: var(--space-3);">
                <a href={`/musings/${post.slug}/`} style="color: var(--color-black); text-decoration: none;">
                  <h2 style="font-size: var(--font-size-4); margin-bottom: var(--space-1);">
                    {post.data.title}
                  </h2>
                  <p style="font-family: var(--font-mono); font-size: var(--font-size-2); color: var(--color-gray);">
                    {post.data.date}
                  </p>
                  {post.data.description && (
                    <p style="font-family: var(--font-mono); font-size: var(--font-size-2);">
                      {post.data.description}
                    </p>
                  )}
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>